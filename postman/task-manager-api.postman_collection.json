        { "name": "Delete Role", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "url": "{{base_url}}/roles/{{role_id}}" } },
        { "name": "Available Role Users", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{base_url}}/roles/available-users?search=&role_id={{role_id}}" } }
