    {
      "name": "Tasks",
      "item": [
        { "name": "List Tasks", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{base_url}}/tasks?search=&status=&sort=newest&page=1&per_page=15" } },
        { "name": "Eligible Task Users", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{base_url}}/tasks/eligible-users?search=" } },
        { "name": "Create Draft Task", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"تسک جدید\",\n  \"short_description\": \"شرح کوتاه\",\n  \"request_description\": \"شرح درخواست\",\n  \"assignee_ids\": [{{assignee_id}}],\n  \"follower_ids\": [],\n  \"supervisor_ids\": [],\n  \"submit\": false\n}" }, "url": "{{base_url}}/tasks" } },
        { "name": "Submit Task", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"duration_minutes\": 120,\n  \"due_date\": \"2026-12-31\",\n  \"assignee_ids\": [{{assignee_id}}],\n  \"submit\": true\n}" }, "url": "{{base_url}}/tasks/{{task_id}}" } },
        { "name": "Show Task", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{base_url}}/tasks/{{task_id}}" } },
        { "name": "Update Task", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"عنوان اصلاح‌شده\"\n}" }, "url": "{{base_url}}/tasks/{{task_id}}" } },
        { "name": "Approve Task Request", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "url": "{{base_url}}/tasks/{{task_id}}/approve" } },
        { "name": "Reject Task Request", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"دلیل رد درخواست\"\n}" }, "url": "{{base_url}}/tasks/{{task_id}}/reject" } },
        { "name": "Request Task Revision", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"reason\": \"لطفاً اصلاح شود\"\n}" }, "url": "{{base_url}}/tasks/{{task_id}}/request-revision" } },
        { "name": "Change Task Status", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"completed\"\n}" }, "url": "{{base_url}}/tasks/{{task_id}}/status" } },
