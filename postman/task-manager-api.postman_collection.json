        { "name": "List Roles", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{base_url}}/roles" } },
        { "name": "Create Role", "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"مدیر واحد\",\n  \"user_id\": {{role_user_id}},\n  \"parent_id\": null\n}" }, "url": "{{base_url}}/roles" } },
