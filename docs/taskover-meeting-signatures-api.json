  "components": {
    "securitySchemes": {
      "sanctum": {
        "type": "http",
        "scheme": "bearer",
        "description": "Existing Sanctum authentication; existing stateful session authentication also applies."
      }
    },
    "schemas": {
      "MeetingSignResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "meeting"
            ],
            "properties": {
              "meeting": {
                "$ref": "#/components/schemas/MeetingWithSignatures"
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "MeetingWithSignatures": {
        "type": "object",
        "required": [
          "id",
          "status",
          "signature_content_version",
          "attendees",
          "allowed_actions"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
          "signature_content_version": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MeetingAttendeeWithSignature"
            }
          },
          "allowed_actions": {
            "type": "object",
            "required": [
              "edit",
              "start",
              "acknowledge",
              "sign"
            ],
            "properties": {
              "edit": {
                "type": "boolean"
              },
              "start": {
                "type": "boolean"
              },
              "acknowledge": {
                "type": "boolean"
              },
              "sign": {
                "type": "boolean"
              }
            }
          }
        },
        "description": "Additive signature fields; all existing MeetingResource fields remain available. Existing meeting list summaries are unchanged."
      },
      "MeetingAttendeeWithSignature": {
        "allOf": [
          {
            "$ref": "#/components/schemas/MentionUser"
          },
          {
            "type": "object",
            "required": [
              "signature_status",
              "signed_at",
              "signed_content_version",
              "can_sign"
            ],
            "properties": {
              "signature_status": {
                "type": "string",
                "enum": [
                  "unsigned",
                  "signed",
                  "outdated"
                ]
              },
              "signed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "Timestamp for CURRENT content only. Null for unsigned/outdated. Convert ISO UTC to Asia/Tehran for display."
              },
              "signed_content_version": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$",
                "description": "Signed content hash; may refer to an older version when status=outdated."
              },
              "can_sign": {
                "type": "boolean",
                "description": "True only for the current authenticated attendee, completed meeting, meetings:view permission and no signature for current content."
              }
            }
          }
        ]
      },
      "MentionUser": {
        "type": "object",
        "required": [
          "id",
          "org_code",
          "first_name",
          "last_name",
          "full_name",
          "title",
          "avatar_file_id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "org_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "avatar_file_id": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    }
  },
  "x-frontend-integration": {
    "language": "fa-IR",
    "api_base_url": "https://taskover.ir/api/v1",
    "scope": "امضای مصوبات نهایی پس از اتمام جلسه، مطابق جدول نام/وضعیت/تاریخ",
    "flow": [
      "GET /api/v1/meetings/{meeting} را بگیرید و متن نهایی مصوبات را نشان دهید.",
      "دکمه فقط برای ردیف کاربر جاری با can_sign=true فعال باشد.",
      "POST /api/v1/meetings/{meeting}/sign را با content_version برابر signature_content_version همان پاسخ بفرستید.",
      "بعد از موفقیت data.meeting را جایگزین یا query جلسه را invalidate کنید."
    ],
    "headers": {
      "Accept": "application/json",
      "Authorization": "Bearer <ACCESS_TOKEN>",
      "Content-Type": "application/json"
    },
    "ui_fields": {
      "name": "attendees[].full_name",
      "status": "attendees[].signature_status",
      "time": "attendees[].signed_at",
      "sign_button": "attendees[].can_sign یا meeting.allowed_actions.sign",
      "version_to_submit": "meeting.signature_content_version"
    },
    "states": {
      "signed": "تیک آبی و تاریخ/ساعت امضای محتوای فعلی",
      "unsigned": "ـ برای وضعیت و تاریخ",
      "outdated": "امضای نسخه قبلی؛ نیازمند تأیید مجدد، signed_at فعلی null"
    },
    "time_display": {
      "server_format": "ISO 8601 UTC",
      "display_timezone": "Asia/Tehran",
      "display_calendar": "Persian",
      "example": "Intl.DateTimeFormat(\"fa-IR\", { timeZone: \"Asia/Tehran\", dateStyle: \"short\", timeStyle: \"short\" })"
    },
    "rules": [
      "فقط status=completed؛ اتمام منتظر امضای اعضا نمی‌ماند.",
      "فقط خود عضو فعال دارای meetings:view؛ مدیر/سوپرادمین نیز باید شخصاً عضو باشد.",
      "view و sign مستقل‌اند؛ تصویر امضای پروفایل ورودی این API نیست.",
      "تکرار امضا با همان محتوا موفق است و زمان اولیه تغییر نمی‌کند.",
      "content_version را ثابت نگذارید؛ مقدار واقعی GET را بفرستید. امضای نسخه قدیمی برای محتوای جدید معتبر نیست."
    ],
    "prohibited_client_fields": [
      "user_id",
      "attendee_user_id",
      "signed_at",
      "signature_file_id",
      "content_snapshot"
    ],
    "errors": {
      "401": "ورود لازم است",
      "403": "نبود مجوز/عضویت، حساب غیرفعال یا جلسه پایان نیافته است",
      "404": "جلسه یافت نشد",
      "409": "محتوا تغییر کرده؛ جلسه را دوباره بگیرید، متن جدید را نمایش دهید و تأیید مجدد بگیرید",
      "422": "خطای ورودی؛ errors فیلدها را نمایش دهید"
    },
    "examples_are_illustrative": true,
    "signature_type": "Authenticated acknowledgment; not certificate-based cryptographic signing."
  },
