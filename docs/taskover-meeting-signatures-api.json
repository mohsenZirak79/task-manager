        "description": "Authenticated acknowledgment, not certificate-based digital signing. Only active attendees with meetings:view may sign after status=completed, including admins only when personally attending. View/start/complete remain independent. Exact retries preserve first signed_at. Content mismatch409; refresh GET and ask for consent again.",
        "x-validation-source": "App\\Http\\Requests\\SignMeetingRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content_version"
                ],
                "properties": {
                  "content_version": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "Copy signature_content_version from the latest GET meeting. Never hardcode this illustrative hash."
                  }
                },
                "description": "user_id, attendee_user_id, signed_at, signature_file_id and content_snapshot are prohibited. Signing actor and time come from server authentication/clock."
              },
              "example": {
                "content_version": "7a1975dfaadd0bf01dd0e6859d868caedfaee90f3c078e5614934e17213124ca"
              }
            }
          }
        }
