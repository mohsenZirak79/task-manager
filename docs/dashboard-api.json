{
  "openapi": "3.1.0",
  "info": {
    "title": "Task Manager Dashboard API",
    "version": "1.1.0",
    "description": "Task Manager dashboard 1.1; backwards-compatible dashboard and pagination. Completed timing uses the accepted completion_requested_at, with explicitly counted completed_at fallback. See dashboard-api.md for snapshots, workflow validation, history and database test instructions."
  },
